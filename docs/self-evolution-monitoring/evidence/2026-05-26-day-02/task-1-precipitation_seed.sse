event: delegated_tool_call
data: {"agent":"coordinator","agent_tab":"coordinator","event":{"tool_input":{"command":"# C11-C13: mission state\npython3 -c \"\nimport json\nms = json.load(open('shared/.omc/state/mission-state.json'))\nmissions = ms['missions']\nprint(f'C11 missions: {len(missions)}')\nagents = []\nfor m in missions:\n    for a in m['agents']:\n        agents.append(a)\n        cs = a.get('completedSummary')\n        print(f'  agent={a[\\\"name\\\"]} completedSummary={cs}')\nprint(f'C12 agents: {len(agents)}')\nnon_null = sum(1 for a in agents if a.get('completedSummary') is not None)\nprint(f'C13 non-null completedSummary: {non_null}')\n\""},"tool_name":"shell","type":"tool_call"},"task_id":"dc709c67-9d49-46b0-86d5-408e9b54cd8c"}

