data: {"agent":"coordinator","agent_tab":"coordinator","event":{"tool_input":{"command":"cd /Users/quantum/.macaca/workspaces/a9435a4b-d123-5a4c-b0b7-d9b1342089ea && echo \"=== C1: Governance artifacts ===\" && ls shared/self_evolution_*.md 2>/dev/null | wc -l && echo \"=== C2: Governance total lines ===\" && cat shared/self_evolution_*.md 2>/dev/null | wc -l && echo \"=== C3: Verification artifacts ===\" && ls agents/coordinator/*verify* shared/live-loop* shared/self_evol_4* 2>/dev/null | wc -l && echo \"=== C4: available_skills dirs ===\" && ls -d available_skills/*/ 2>/dev/null | wc -l && echo \"=== C5: Convention-compliant ===\" && for d in available_skills/*/; do if [ -f \"$d/SKILL.md\" ] && [ -f \"$d/_meta.json\" ]; then echo \"$d\"; fi; done | wc -l && echo \"=== C8: Agent replay files ===\" && ls shared/.omc/state/agent-replay-*.jsonl 2>/dev/null | wc -l && echo \"=== C11: Missions ===\" && python3 -c \"import json; ms=json.load(open('shared/.omc/state/mission-state.json')); print(len(ms['missions']))\" && echo \"=== C12: Agents ===\" && python3 -c \"import json; ms=json.load(open('shared/.omc/state/mission-state.json')); print(sum(len(m['agents']) for m in ms['missions']))\" && echo \"=== C13: Non-null completedSummary ===\" && python3 -c \"import json; ms=json.load(open('shared/.omc/state/mission-state.json')); print(sum(1 for m in ms['missions'] for a in m['agents'] if a.get('completedSummary') is not None))\" && echo \"=== C14: .registry.json ===\" && find . -name \".registry.json\" -not -path \"*/node_modules/*\" -not -path \"*/.next/*\" 2>/dev/null | wc -l && echo \"=== C15: _usage.json ===\" && find . -name \"_usage.json\" -not -path \"*/node_modules/*\" -not -path \"*/.next/*\" 2>/dev/null | wc -l && echo \"=== C16: *.sse ===\" && find . -name \"*.sse\" -not -path \"*/node_modules/*\" -not -path \"*/.next/*\" 2>/dev/null | wc -l && echo \"=== C17: MCP servers ===\" && grep -c \"mcpServers\" ~/.macaca/mcp.yaml 2>/dev/null || echo \"0\" && echo \"=== C23: skills/ dirs ===\" && ls -d skills/*/ 2>/dev/null | wc -l && echo \"=== C24: Mutation mementos ===\" && find . -path \"*skill-mutation-mementos*\" -name \"*.json\" 2>/dev/null | wc -l && echo \"=== C25: Crontab ===\" && (crontab -l 2>/dev/null || echo \"NO_CRONTAB\")"},"tool_name":"shell","type":"tool_call"},"task_id":"226009eb-e95e-4d61-8795-11758464943a"}

