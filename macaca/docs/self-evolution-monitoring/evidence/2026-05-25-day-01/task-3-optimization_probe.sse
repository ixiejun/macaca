data: {"agent":"coordinator","agent_tab":"coordinator","event":{"tool_input":{"command":"echo \"=== C1: Governance artifacts ===\" && ls shared/self_evolution_*.md 2>/dev/null | wc -l && echo \"=== C2: Governance lines ===\" && cat shared/self_evolution_*.md 2>/dev/null | wc -l && echo \"=== C3: Verification artifacts ===\" && ls agents/coordinator/*verify* shared/live-loop* shared/self_evol_4* 2>/dev/null | wc -l && echo \"=== C4: available_skills dirs ===\" && ls -d available_skills/*/ 2>/dev/null | wc -l && echo \"=== C5: Convention-compliant dirs ===\" && for d in available_skills/*/; do [ -f \"$d/SKILL.md\" -a -f \"$d/_meta.json\" ] && echo 1; done | wc -l && echo \"=== C6: Pipeline-produced (proposal_id evidence) ===\" && find available_skills -name \"proposal_id*\" 2>/dev/null | wc -l && echo \"=== C7: _meta.json with proposal_id ===\" && python3 -c \"import json,glob; c=0; [exec('d=json.load(open(f)); c+=(\\\"proposal_id\\\" in d)') for f in glob.glob('available_skills/*/_meta.json')]; print(c)\" && echo \"=== C8: Agent replay files ===\" && ls shared/.omc/state/agent-replay-*.jsonl 2>/dev/null | wc -l && echo \"=== C9: Replay events ===\" && cat shared/.omc/state/agent-replay-*.jsonl 2>/dev/null | wc -l && echo \"=== C11: Missions ===\" && python3 -c \"import json; ms=json.load(open('shared/.omc/state/mission-state.json')); print(len(ms['missions']))\" && echo \"=== C12: Agents ===\" && python3 -c \"import json; ms=json.load(open('shared/.omc/state/mission-state.json')); print(sum(len(m['agents']) for m in ms['missions']))\" && echo \"=== C13: Non-null completedSummary ===\" && python3 -c \"import json; ms=json.load(open('shared/.omc/state/mission-state.json')); print(sum(1 for m in ms['missions'] for a in m['agents'] if a.get('completedSummary') is not None))\""},"tool_name":"shell","type":"tool_call"},"task_id":"39e8b501-5d94-42e2-918f-cb7afedce4a2"}

