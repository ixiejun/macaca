data: {"agent":"coordinator","agent_tab":"coordinator","event":{"output":"{\"cwd\":\"/Users/quantum/.macaca/workspaces/a9435a4b-d123-5a4c-b0b7-d9b1342089ea\",\"exit_code\":0,\"stderr\":\"\",\"stdout\":\"# Macaca Agent OS global MCP registry.\\n#\\n# This file is read by `McpRuntimeFacade::load_default` when the Macaca backend\\n# starts.  The server below is intentionally configured as a generic stdio MCP\\n# definition: Macaca owns service registration, policy checks, trace/audit\\n# metadata, and invocation routing, while the package owns only the external\\n# search/crawl protocol implementation.  The package is installed globally so\\n# agent toolkit probes do not pay an `npx` cold-start/install cost.\\nmcpServers:\\n  bing-search:\\n    transport: stdio\\n    command: /Users/quantum/.volta/bin/bing-cn-mcp\\n    args: []\\n    env:\\n      # The local shell may export HTTP(S)_PROXY for unrelated developer tools.\\n      # This Bing MCP reaches cn.bing.com more reliably without that proxy in\\n      # the current Macaca workstation environment, so the child process clears\\n      # both uppercase and lowercase proxy variables while keeping the rest of\\n      # Macaca's runtime environment untouched.\\n      HTTP_PROXY: \\\"\\\"\\n      HTTPS_PROXY: \\\"\\\"\\n      ALL_PROXY: \\\"\\\"\\n      http_proxy: \\\"\\\"\\n      https_proxy: \\\"\\\"\\n      all_proxy: \\\"\\\"\\n    requiredBins:\\n      - /Users/quantum/.volta/bin/bing-cn-mcp\\n    lifecycle: agent_session\\n    session_mode: stateful\\n    enabled: true\\n\"}","tool_name":"shell","type":"tool_result"},"task_id":"887fd09a-450a-4f20-9c97-12575eca5cbf"}

